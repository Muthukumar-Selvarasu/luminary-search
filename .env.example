# ==============================================================================
# LUMINA - Environment Configuration Template (.env.example)
# ==============================================================================
# Both backend/gateway and backend/agent read this single .env file at the repo root.
# Copy this file to .env and configure with your active credentials and settings.

# ------------------------------------------------------------------------------
# Service Ports & Networking
# ------------------------------------------------------------------------------
# Gateway Port (Default: 8787)
PORT_GATEWAY=8787
GATEWAY_PORT=8787

# Agent Port (Default: 8000)
PORT_AGENT=8000
AGENT_PORT=8000

# Agent URL for Gateway Reverse Proxy
AGENT_URL=http://localhost:8000

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Rate Limiting & Quotas
# ------------------------------------------------------------------------------
# In-memory sliding window rate limit (requests per minute per X-User-Id)
RATE_LIMIT_PER_MINUTE=30

# Daily cap for deep search requests per user (enforced in backend/agent)
DEEP_DAILY_CAP=5

# ------------------------------------------------------------------------------
# Database & Vector Search (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB connection string with Atlas Vector Search enabled
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lumina

# Vector Backend: 'atlas-vector-search' (production) | 'mongo-cosine-scan' (fallback)
VECTOR_BACKEND=atlas-vector-search

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider: 'anthropic' | 'openai'
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# Provider API keys (Read server-side only in backend/agent)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Embedding model for document indexing and semantic retrieval
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# Web Search Provider Configuration
# ------------------------------------------------------------------------------
# Provider: 'tavily' | 'serpapi'
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-api-key-here
SERPAPI_API_KEY=your-serpapi-api-key-here
SERPER_API_KEY=your-serper-api-key-here

# Two-tier cache TTL (seconds) for search queries (default: 6 hours)
SEARCH_CACHE_TTL_SECONDS=21600

# ------------------------------------------------------------------------------
# Agent Execution Envelopes & Hard Caps (AGENTS.md)
# ------------------------------------------------------------------------------
# Quick Search Budget
MAX_TOOL_CALLS=8
MAX_WALL_CLOCK_SEC=90

# Deep Search Budget
MAX_TOOL_CALLS_DEEP=24
MAX_WALL_CLOCK_SEC_DEEP=240

# Deep Search Sub-question Bounds
DEEP_SUB_QUESTIONS_MIN=3
DEEP_SUB_QUESTIONS_MAX=6

# ------------------------------------------------------------------------------
# Dynamic Artifacts & Image Generation Safeguards
# ------------------------------------------------------------------------------
IMAGE_GEN_API_KEY=your-image-gen-key-here
IMAGE_DAILY_QUOTA=10
DRY_RUN=false

# ------------------------------------------------------------------------------
# Cloud Deployment Tokens (Railway & Vercel)
# ------------------------------------------------------------------------------
# Railway Project Token (UUID from Project Settings → Tokens). Dashes are required.
# Used by `npm run deploy` for headless `railway up`. Project tokens cannot run `railway whoami`.
# Do not paste a project/service/environment id. Do not set RAILWAY_API_TOKEN at the same time.
RAILWAY_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Vercel Token & Project Identifiers for automated Gateway deployment (vercel --token)
VERCEL_TOKEN=your-vercel-api-token-here
VERCEL_ORG_ID=you-can-leave-blank
VERCEL_PROJECT_ID=you-can-leave-blank
